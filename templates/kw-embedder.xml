<?xml version="1.0"?>
<!--
  kw-embedder - the Keystone Wealth embedding engine: kb-service run in embedder mode
  (github.com/sdr-ventures/kb-service, image kb-service, KB_MODE=embedder). Nothing here is
  specific to any host or operator.

  WHAT IT DOES. Answers POST /v1/embed per keystone's embedder-call contract 1.0.0: 1 to 64 texts
  in, each up to 8000 characters, one vector per text out. Stateless: no database, no data volume, scratch in RAM, one bearer,
  and nothing of the input or output is kept or logged beyond tenant, model, count, milliseconds
  and success.

  NETWORK. Set the Network field to the internal Docker network the Keystone containers share
  (no route out) and give it a fixed address there. It publishes no port. Keep the model server
  off that shared network: put it and this container on a second internal network of their own
  (internal, no gateway) and name the model server by container name in KB_EMBED_BASE_URL, so
  only this container can reach it. Docker attaches one network per template, so the second
  attachment is a docker network connect that a boot-time script repeats.

  HARDENING. Extra Parameters ships empty (repo rule). After import, add these docker run options (each begins with two dashes): read-only; tmpfs /tmp:size=64m; tmpfs /export:size=1m; tmpfs /assets:size=1m; cap-drop=ALL; security-opt no-new-privileges; cpus=2; memory=512m
  It gives: read-only root, RAM scratch over the two paths the
  image declares as volumes (so no anonymous volume is created), all capabilities dropped, no new
  privileges, and CPU and memory caps.

  THE TOKEN. KB_EMBEDDER_TOKEN ships blank. Use 32 or more random characters and give the same
  value to keystone as its embedder bearer. The container exits 2 if it is blank or short.
-->
<Container version="2">
  <Name>kw-embedder</Name>
  <Repository>ghcr.io/sdr-ventures/kb-service:v0.5.1</Repository>
  <Registry>https://github.com/sdr-ventures/kb-service/pkgs/container/kb-service</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/sdr-ventures/kb-service/issues</Support>
  <Project>https://github.com/sdr-ventures/kb-service</Project>
  <Overview>The embedding engine for Keystone Wealth: turns text into vectors for keystone. Stateless, no data volume, one bearer, reachable only on the internal network. Needs a model server reachable on that network and a token shared with keystone.</Overview>
  <Category>Productivity: Tools:Utilities</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/sdr-ventures/unraid-templates/main/templates/kw-embedder.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/sdr-ventures/unraid-templates/main/icons/kw-embedder.png</Icon>
  <ExtraParams/>
  <DateInstalled/>
  <Description>Embedding engine for Keystone Wealth. No data kept.</Description>
  <Config Name="KB_MODE" Target="KB_MODE" Default="embedder" Mode="" Description="REQUIRED. Run the embedder engine only. Leave embedder." Type="Variable" Display="always" Required="true" Mask="false">embedder</Config>
  <Config Name="KB_EMBEDDER_TOKEN" Target="KB_EMBEDDER_TOKEN" Default="" Mode="" Description="REQUIRED. Bearer keystone presents, 32 or more random characters. Blank on purpose; the container exits 2 without it." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="KB_EMBED_BASE_URL" Target="KB_EMBED_BASE_URL" Default="" Mode="" Description="REQUIRED. OpenAI-style embeddings endpoint of the model server on the same internal network, ending in /v1." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="KB_EMBED_MODEL" Target="KB_EMBED_MODEL" Default="qwen3-embedding:0.6b" Mode="" Description="REQUIRED. Embedding model name as the model server lists it." Type="Variable" Display="always" Required="true" Mask="false">qwen3-embedding:0.6b</Config>
  <Config Name="KB_EMBED_API_KEY" Target="KB_EMBED_API_KEY" Default="" Mode="" Description="Optional. Key for the model server above, sent as its bearer token. Blank if the model server takes none." Type="Variable" Display="advanced" Required="false" Mask="true"/>
</Container>
