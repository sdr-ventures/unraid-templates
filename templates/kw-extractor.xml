<?xml version="1.0"?>
<!--
  kw-extractor - the Keystone Wealth statement reader: kb-service run in extractor mode
  (github.com/sdr-ventures/kb-service, image kb-service, KB_MODE=extractor). Nothing here is
  specific to any host or operator.

  WHAT IT DOES. Answers POST /v1/extract per keystone's extractor-call contract 1.1.0: a PDF
  statement with a text layer in, a ParseResult 1.2.0 out. Stateless: no database, no data volume,
  the file is read in memory, scratch is RAM, and nothing of the file or the answer is kept or
  logged beyond tenant, file id, model, milliseconds and success. One run at a time (429 when busy).

  THE MODEL. It calls a LiteLLM-compatible router at LITELLM_URL using a key that allows local
  models only. KB_EXTRACT_MODEL is the router group. It needs a model that follows a JSON schema;
  allow about 80 seconds per dense page on a mid-range GPU. When the model is unreachable the
  container answers 503 with Retry-After 60.

  NETWORK. Set the Network field to the internal Docker network the Keystone containers share
  (no route out) and give it a fixed address there. It publishes no port. If the router is outside
  that network, send the call through the network's egress proxy: set HTTP_PROXY and NO_PROXY (below)
  and allow that one destination there. Both ship blank, which means direct.

  HARDENING. Extra Parameters ships empty (repo rule). After import, add these docker run options (each begins with two dashes): read-only; tmpfs /tmp:size=256m; tmpfs /export:size=1m; tmpfs /assets:size=1m; cap-drop=ALL; security-opt no-new-privileges; cpus=2; memory=1g
  It gives: read-only root, RAM scratch, all capabilities
  dropped, no new privileges, CPU and memory caps.

  THE TOKEN. KB_EXTRACTOR_TOKEN ships blank. Use 32 or more random characters and give the same
  value to keystone as its extractor bearer. The container exits 2 if it is blank or short.
-->
<Container version="2">
  <Name>kw-extractor</Name>
  <Repository>ghcr.io/sdr-ventures/kb-service:v0.9.1</Repository>
  <Registry>https://github.com/sdr-ventures/kb-service/pkgs/container/kb-service</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/sdr-ventures/kb-service/issues</Support>
  <Project>https://github.com/sdr-ventures/kb-service</Project>
  <Overview>The statement reader for Keystone Wealth: turns a PDF statement into structured accounts and positions using a local model. Stateless, no data volume, one bearer, reachable only on the internal network.</Overview>
  <Category>Productivity: Tools:Utilities</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/sdr-ventures/unraid-templates/main/templates/kw-extractor.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/sdr-ventures/unraid-templates/main/icons/kw-extractor.png</Icon>
  <ExtraParams/>
  <DateInstalled/>
  <Description>Statement reader for Keystone Wealth. No data kept.</Description>
  <Config Name="KB_MODE" Target="KB_MODE" Default="extractor" Mode="" Description="REQUIRED. Run the extractor engine only. Leave extractor." Type="Variable" Display="always" Required="true" Mask="false">extractor</Config>
  <Config Name="KB_EXTRACTOR_TOKEN" Target="KB_EXTRACTOR_TOKEN" Default="" Mode="" Description="REQUIRED. Bearer keystone presents. 32 or more random characters." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="LITELLM_URL" Target="LITELLM_URL" Default="" Mode="" Description="REQUIRED. Base URL of the model router, for example http://router:4000." Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="LITELLM_KEY" Target="LITELLM_KEY" Default="" Mode="" Description="REQUIRED. Router key that allows local models only." Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="KB_EXTRACT_MODEL" Target="KB_EXTRACT_MODEL" Default="large" Mode="" Description="Router group that reads statements." Type="Variable" Display="always" Required="false" Mask="false">large</Config>
  <Config Name="KB_EXTRACT_DEADLINE_SECONDS" Target="KB_EXTRACT_DEADLINE_SECONDS" Default="840" Mode="" Description="Seconds a run may take before it answers 504. Keep 840: keystone's own timeout is 900." Type="Variable" Display="advanced" Required="false" Mask="false">840</Config>
  <Config Name="KB_EXTRACT_BACKUP_KEY" Target="KB_EXTRACT_BACKUP_KEY" Default="" Mode="" Description="Optional. Router key that allows Haiku only, for the backup run keystone asks for. Blank means no backup: the request header is ignored and the run stays on local models." Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="HTTP_PROXY" Target="HTTP_PROXY" Default="" Mode="" Description="Optional. Egress proxy URL, for example http://proxy.example:3128, when the router is outside the internal network. Blank means a direct connection." Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="NO_PROXY" Target="NO_PROXY" Default="" Mode="" Description="Optional. Comma-separated hosts that skip HTTP_PROXY, such as the router's own name. Blank means none." Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
