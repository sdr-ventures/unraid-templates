<?xml version="1.0"?>
<!--
  kw-vault - the Keystone Wealth file sandbox (github.com/sdr-ventures/kw-vault). Nothing here is
  specific to any host or operator.

  WHAT IT DOES. Answers POST /v1/open per its open contract (docs/open-contract.md in the repo):
  kw-core sends one uploaded file (a PDF, an image or a CSV) and gets back only plain text, word
  boxes, tables and page images, or decoded CSV rows. Each file is opened in a locked-down child
  process with size, page and time limits; a refused file answers with a coded reason. Stateless:
  no database, no data volume, nothing kept after a request. GET /v1/health answers without a bearer.

  NETWORK. Set the Network field to the internal Docker network the Keystone containers share
  (no route out) and give it a fixed address there. It publishes no port and needs no egress.

  HARDENING. Extra Parameters ships empty (repo rule). After import, add these docker run options (each begins with two dashes): read-only; tmpfs /tmp:size=64m; cap-drop=ALL; security-opt no-new-privileges; cpus=2; memory=3g
  The parser child is capped at 2 GiB and two may run at once, so keep memory at least 2.5g.

  THE TOKEN. KW_VAULT_BEARER ships blank. Use 32 or more random characters and give the same
  value to kw-core as the sandbox bearer. The container refuses to start without it.
-->
<Container version="2">
  <Name>kw-vault</Name>
  <Repository>ghcr.io/sdr-ventures/kw-vault:stable</Repository>
  <Registry>https://github.com/sdr-ventures/kw-vault/pkgs/container/kw-vault</Registry>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/sdr-ventures/kw-vault/issues</Support>
  <Project>https://github.com/sdr-ventures/kw-vault</Project>
  <Overview>The file sandbox for Keystone Wealth: opens each uploaded PDF, image or CSV with no network reach and returns only text, word boxes, tables and page images. Stateless, no data volume, one bearer, reachable only on the internal network.</Overview>
  <Category>Productivity: Tools:Utilities</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/sdr-ventures/unraid-templates/main/templates/kw-vault.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/sdr-ventures/unraid-templates/main/icons/kw-vault.png</Icon>
  <ExtraParams/>
  <DateInstalled/>
  <Description>File sandbox for Keystone Wealth. No data kept.</Description>
  <Config Name="KW_VAULT_BEARER" Target="KW_VAULT_BEARER" Default="" Mode="" Description="REQUIRED. Bearer kw-core presents. 32 or more random characters." Type="Variable" Display="always" Required="true" Mask="true"/>
</Container>
